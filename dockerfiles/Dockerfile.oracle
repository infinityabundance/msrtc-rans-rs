# Oracle build stage - Microsoft MLVC msrtc_rans C++ oracle
FROM debian:12-slim AS oracle-builder

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pipx \
        python3 \
        python3-dev \
        python3-pip \
        python3-numpy \
        python3-full \
        git \
        ca-certificates \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/* && \
    pip3 install --break-system-packages --no-cache-dir 'cmake>=3.27' || \
    pip3 install --no-cache-dir 'cmake>=3.27'

WORKDIR /workspace
COPY mlvc-upstream /workspace/mlvc-upstream
COPY harness      /workspace/harness

# ---- Build msrtc_rans static lib + python module --------------------------
RUN mkdir -p /workspace/build/msrtc_rans && \
    cmake -S /workspace/mlvc-upstream/packages/msrtc_rans \
          -B /workspace/build/msrtc_rans \
          -G Ninja \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_PYTHON_MODULE=ON \
          -DINSTALL_ONLY_PYTHON_MODULE=ON && \
    cmake --build /workspace/build/msrtc_rans --config Release

# ---- Build oracle_cli + raw_oracle_cli + decoder_oracle_cli + stream_oracle_cli harness ----
RUN mkdir -p /workspace/build/harness && \
    cmake -S /workspace/harness \
          -B /workspace/build/harness \
          -G Ninja \
          -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /workspace/build/harness --config Release

# Test stage - run oracle tests
FROM debian:12-slim AS oracle-test

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        python3 \
        python3-pip \
        python3-numpy \
        python3-pytest \
    && rm -rf /var/lib/apt/lists/*

COPY --from=oracle-builder /workspace/mlvc-upstream/packages/msrtc_rans /workspace/mlvc
COPY --from=oracle-builder /workspace/build/msrtc_rans/Release/msrtc/rans/_msrtc_rans.cpython-311-x86_64-linux-gnu.so /workspace/mlvc/python/src/msrtc/rans/_msrtc_rans.cpython-311-x86_64-linux-gnu.so
COPY --from=oracle-builder /workspace/build/harness/oracle_cli /workspace/bin/oracle_cli
COPY --from=oracle-builder /workspace/build/harness/raw_oracle_cli /workspace/bin/raw_oracle_cli
COPY --from=oracle-builder /workspace/build/harness/decoder_oracle_cli /workspace/bin/decoder_oracle_cli
COPY --from=oracle-builder /workspace/build/harness/stream_oracle_cli /workspace/bin/stream_oracle_cli
COPY --from=oracle-builder /workspace/harness/testdata       /workspace/testdata

ENV PYTHONPATH=/workspace/mlvc/python/src:$PYTHONPATH

WORKDIR /workspace/mlvc/python/test
CMD ["python3", "-m", "pytest", "-v", "test_msrtc_rans.py"]
