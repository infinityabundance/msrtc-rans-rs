# Stage 1: Build the Rust workspace (excluding python crate)
FROM rust:latest AS rust-builder

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    python3 python3-dev python3-pip \
    libpython3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY source /workspace/source

RUN cargo build --manifest-path /workspace/source/Cargo.toml \
    --workspace --exclude msrtc-rans-python --release 2>&1 | tail -5

# Stage 2: Build the Python extension
FROM python:3.11-slim AS py-builder

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    python3-dev build-essential curl pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH=/root/.cargo/bin:$PATH
RUN pip3 install maturin numpy --no-cache-dir

WORKDIR /workspace
COPY source /workspace/source
COPY --from=rust-builder /workspace/source/target /workspace/source/target

# Build wheel
RUN cd /workspace/source/crates/msrtc-rans-python && \
    maturin build --release 2>&1 | tail -10

# Stage 3: Test
FROM python:3.11-slim

RUN pip3 install pytest numpy --no-cache-dir

# Copy wheel, Python source, and test fixtures
COPY --from=py-builder /workspace/source/target/wheels /wheels
COPY source/crates/msrtc-rans-python/python /python_source
COPY mlvc-upstream/packages/msrtc_rans/python/test /tests

# Install the native extension wheel
RUN pip3 install /wheels/*.whl --no-cache-dir && \
    # Layer the msrtc.rans package on top
    cp -r /python_source/msrtc /usr/local/lib/python3.11/site-packages/msrtc

ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /tests
CMD ["python3", "-m", "pytest", "-v", "test_msrtc_rans.py"]
